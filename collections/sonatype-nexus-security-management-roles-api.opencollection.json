        {
          "info": {
            "name": "Delete role",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/service/rest/v1/security/roles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id of the role to delete"
              }
            ]

              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create role"
        },
        {
          "info": {
            "name": "Get role",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/service/rest/v1/security/roles/:id",
            "params": [
              {
                "name": "source",
                "value": "",
                "type": "query",
                "description": "The id of the user source to filter the roles by. Available sources can be fetched using the 'User Sources' endpoint."

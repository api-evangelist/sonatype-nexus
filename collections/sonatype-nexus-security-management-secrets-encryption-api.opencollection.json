{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonatype Nexus Repository Manager assets Security management: secrets encryption API",
    "version": "3.91.0-07"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Security management: secrets encryption",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Re-encrypt secrets using the specified key",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/service/rest/v1/secrets/encryption/re-encrypt",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Ensure all nodes have access to the key, and they use the same key"
        }
      ]
    }
  ],
  "bundled": true
}
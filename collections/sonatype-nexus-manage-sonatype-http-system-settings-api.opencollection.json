{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonatype Nexus Repository Manager assets Manage Sonatype HTTP System Settings API",
    "version": "3.91.0-07"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Manage Sonatype HTTP System Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get HTTP system settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/service/rest/v1/http"
          },
          "docs": "Get HTTP system settings"
        },
        {
          "info": {
            "name": "Update HTTP system settings",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/service/rest/v1/http",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update HTTP system settings"
        },
        {
          "info": {
            "name": "Reset HTTP System Settings",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/service/rest/v1/http"
          },
          "docs": "Reset HTTP System Settings"
        }
      ]
    }
  ],
  "bundled": true
}
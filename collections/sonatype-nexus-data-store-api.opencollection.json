{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sonatype Nexus Repository Manager assets Data Store API",
    "version": "3.91.0-07"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data Store",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the data store",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/service/rest/beta/data-store"
          },
          "docs": "Get the data store"
        },
        {
          "info": {
            "name": "Update the data store",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/service/rest/beta/data-store",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the data store"
        }
      ]
    }
  ],
  "bundled": true
}
        {
          "id": "e90f6491-241d-42b2-9b97-e043e3a41f22",
          "name": "List all user tokens",
          "request": {
            "name": "List all user tokens",
            "description": {
              "content": "Lists all user tokens with optional filtering and pagination. Returns metadata only, never the passCode.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "security",
                "user-tokens",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "realm",
                  "value": "<string>",
                  "description": "The realm of the user (optional for cloud, required for self-hosted)"
                },
                {
                  "disabled": false,
                  "key": "userId",
                  "value": "<string>",
                  "description": "Filter by user ID (optional)"
                },
                {
                  "disabled": false,
                  "key": "includeExpired",
                  "value": "<boolean>",
                  "description": "Include expired tokens (default: false)"
                },
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "Number of items to skip for pagination (default: 0)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of items to return (default: 25, max: 100)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [

        {
          "info": {
            "name": "Delete a single routing rule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/service/rest/v1/routing-rules/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "The name of the routing rule to delete"
              }
            ]
          },
          "docs": "Delete a single routing rule"
